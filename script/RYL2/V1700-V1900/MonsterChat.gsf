/////////////////////////////////////////////////////////////////////////////////////																							
/////////////										Function List									/////////////				
/////////////////////////////////////////////////////////////////////////////////////																							

void MonsterChat(int, int, int, int, int, string); // KID, MonsterAction, Monster SkillsID, Chattingtypes, Probability, ChattingMessage

/////////////////////////////////////////////////////////////////////////////////////																							


/////////////////////////////////////////////////////////////////////////////////////																				
/////////////										Definition										/////////////
/////////////////////////////////////////////////////////////////////////////////////  																				
//																				
//		Action ID																		
//																				
//		General attack			0															
//		When get attacked by generalattack	1																	
//		When you attak with skillattack		2																
//		When you get attacked with skillattack	3																	
//		when you attack with ChriAttack		4																
//		when you get attacked with ChriAttack	5																	
//		Lisphone				6														
//		Death					7													
//																				
/////////////////////////////////////////////////////////////////////////////////////							
//							
//		Chatting ID					
//							
//		common Knowledge			255
//		General					0
//		Screaming				7	
//							
/////////////////////////////////////////////////////////////////////////////////////							
//							
//		Skill ID					
//							
//		All Skill			=0xFFFF		
//							
/////////////////////////////////////////////////////////////////////////////////////							
//							
//		$KILLERNAME$		Substitute with killer(monster) name. It's only possible when Action ID matches number 7(death) 	
//		$ATTNAME$			"substitute with hitter(monster) name. It's only possible when Action ID matches number 1, 3, 5(when you get hit)"
//		$DEFNAME$			"substitute with player name who've got hit(monster). It's only possible when Action ID matches number  0, 2, 4 (when you hit) (When there are many players who got hitten, it's random)"
//					
//		"KID, Monster Action, Monster skill ID, When the chatting kinds are same kind, calculate the probability by adding them together."			
//					
/////////////////////////////////////////////////////////////////////////////////////					
//					
//		ex 			
//					
//		"MonsterChat(40235, 2, 0xFFFF, 0, 20, "Chatting message 1 when you use skill level");"			
//		"MonsterChat(40235, 2, 0xFFFF, 0, 20, "Chatting message 2 when you use skill level");"			
//		"(Choose random number from range of 1~100, Above message is from 1~20, below message is from 21~40. Other numbers do not say anything.) "			
//					
//					
/////////////////////////////////////////////////////////////////////////////////////					


