MonsterChat(40235, 2, 0xFFFF, 0, 10, "$DEFNAME$ on your knees... Bow to me, fool!");
MonsterChat(40235, 4, 0, 0, 50, "You shall not pass.");
MonsterChat(40235, 4, 0, 0, 50, "I am the guardian of this foul land.");									
MonsterChat(40235, 7, 0, 0, 100, "I won't die, not now.");										
MonsterChat(40235, 7, 0, 255, 100, "[$KILLERNAME$] has defeated the Ancient Guardian in the Woods of Death.");		

