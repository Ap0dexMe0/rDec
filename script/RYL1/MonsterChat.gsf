//Ancient Guard
MonsterChat(4001, 6, 0, 7, 100, "'Something evil is rising from darkness...'");
MonsterChat(4001, 2, 0xFFFF, 0, 10, "Feel the strength of my pure evil!!! ");
MonsterChat(4001, 2, 0xFFFF, 0, 10, "Darkness is source of my life... Huaaaarrgghhh!!!");
MonsterChat(4001, 4, 0, 0, 50, "Now!!!... Huaaaarrrgghhh!!! You die!!");
MonsterChat(4001, 4, 0, 0, 50, "$DEFNAME$, I will bring you to hell!!!");
MonsterChat(4001, 7, 0, 7, 100, "$KILLERNAME$! The darkness will always follow you!!!...Remember that!!!");

//Flame Demon
MonsterChat(4002, 6, 0, 7, 100, "'In the Ak'kan land,something evil living there now...'");
MonsterChat(4002, 2, 0xFFFF, 0, 10, "Ak'kan land is my home now. Earth's blood is my strength");
MonsterChat(4002, 2, 0xFFFF, 0, 10, "Ak'kan land is source of my life");
MonsterChat(4002, 4, 0, 0, 50, "You shall not come here!!");
MonsterChat(4002, 4, 0, 0, 50, "You should not been arrived here $DEFNAME$");
MonsterChat(4002, 7, 0, 7, 100, "...$KILLERNAME$!!! Remember that i will always return...");

//Lion Warrior
MonsterChat(4003, 6, 0, 7, 100, "'You can hear the Lion roaring in the woods...'");
