MonsterChat(4003, 4, 0, 0, 50, "Soon you will see who is strongest here!");
MonsterChat(4003, 4, 0, 0, 50, "$DEFNAME$, Feel the power of my sword!!!");
MonsterChat(4003, 7, 0, 7, 100, "Ah, $KILLERNAME$ You are strong indeed...But i will be back soon...");

